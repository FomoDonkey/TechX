# =============================================================
# CSM — Variables de entorno
# Copia este archivo a .env y completa los valores que apliquen.
# Las que no completes se desactivan gracefully (sin romper).
# =============================================================

# Node
NODE_ENV=development

# App
NEXT_PUBLIC_APP_NAME=CSM
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de datos (Postgres o MySQL 8+). En local puedes usar Neon free tier.
# Postgres: postgres://USER:PASS@HOST/DB?sslmode=require
# MySQL:    mysql://USER:PASS@HOST:3306/DB
DATABASE_URL=

# Redis (opcional). Si NO está configurado:
#   - DB=Postgres → pubsub usa LISTEN/NOTIFY (cero deps).
#   - DB=MySQL    → pubsub cae a in-memory (sin fanout cross-instancia).
# Si está configurado, pubsub usa Redis (recomendado para multi-instancia con MySQL).
REDIS_URL=

# Better-Auth
AUTH_SECRET=cambia-esto-por-un-string-aleatorio-largo
# OAuth providers (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# IA (Groq es default y gratuito; los demás son opcionales)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Email transaccional (Resend)
RESEND_API_KEY=
RESEND_FROM="CSM <noreply@csm.dev>"

# Storage (UploadThing). Si no, fallback a almacenamiento local en /public/uploads.
UPLOADTHING_TOKEN=

# Stripe (memberships) — opcional
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Replicate (AI image generation) — opcional
REPLICATE_API_TOKEN=

# Hugging Face (AI vision tags) — opcional
HUGGINGFACE_API_KEY=

# Sentry — opcional
NEXT_PUBLIC_SENTRY_DSN=
