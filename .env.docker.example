# ============================================================
# CSM — Configuración Docker
# ============================================================
# Copia este archivo a `.env` (mismo directorio que docker-compose.yml):
#   cp .env.docker.example .env
# Y rellena los valores marcados como REQUERIDO.
# Las variables vacías o ausentes simplemente desactivan la feature
# correspondiente (no crashean).
# ============================================================

# ----------------------------------------------------------
# RED — puertos y bindings
# ----------------------------------------------------------
# IP/hostname donde el contenedor expone CSM en tu host.
# - 127.0.0.1 → solo localhost (recomendado tras Caddy/Nginx/Traefik)
# - 0.0.0.0   → accesible desde toda la red (cuidado: usa firewall)
APP_HOST_BIND=127.0.0.1
APP_PORT=3000

# URL pública por la que tus editores acceden a CSM (incluye el reverse
# proxy si tienes uno). En dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------
# DATABASE_URL — BD EXTERNA (override avanzado, opcional)
# ----------------------------------------------------------
# SOLO si usas `-f docker-compose.external-db.yml` para apuntar a una BD
# que NO vive en este compose (Neon, RDS, MySQL en otro cloud, etc.).
#
# Si NO defines DATABASE_URL, el compose principal construye el URL
# automáticamente desde las variables POSTGRES_* del bloque siguiente.
#
# Formatos soportados:
#   Postgres:  postgres://USER:PASS@HOST:5432/DB?sslmode=require
#   MySQL:     mysql://USER:PASS@HOST:3306/DB
#
# Ejemplo F1 (MySQL externo en cloud SDS):
#   DATABASE_URL=mysql://csm:Tu_Pass_Aqui@5.196.50.3:33060/csm_f1
DATABASE_URL=

# ----------------------------------------------------------
# MYSQL_VECTOR_FALLBACK — solo MySQL 8.x sin tipo VECTOR nativo
# ----------------------------------------------------------
# Las tablas con embeddings (search_index, ai_memories) declaran columnas
# VECTOR(1536). MySQL 9+ las soporta nativamente; MySQL 8.x NO. Si tu BD
# es MySQL 8.x, define este flag a `true` y el schema degrada VECTOR a
# VARBINARY(8192). La búsqueda semántica queda deshabilitada hasta que
# configures Qdrant external (ver docs/SEARCH.md).
# Postgres y MySQL 9+: deja vacío.
MYSQL_VECTOR_FALLBACK=

# ----------------------------------------------------------
# POSTGRES (REQUERIDO si usas docker-compose.yml — BD local en compose)
# ----------------------------------------------------------
# Por defecto la BD NO se expone al host — solo el contenedor de CSM
# le habla por la red interna. Si necesitas conectarte desde tu máquina,
# crea `docker-compose.override.yml` (ver comentarios en docker-compose.yml).
POSTGRES_USER=csm
POSTGRES_DB=csm
# REQUERIDO — generar uno fuerte (mínimo 16 chars):
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# ----------------------------------------------------------
# MYSQL (alternativa a Postgres — solo si usas docker-compose.mysql.yml)
# ----------------------------------------------------------
# CSM soporta MySQL 8.4+ desde Tarea 9. Para usar MySQL como BD principal:
#   1. Sustituye `DATABASE_URL` por mysql://csm:PASS@mysql:3306/csm
#   2. Levanta solo el container mysql:
#        docker compose -f docker-compose.mysql.yml up -d mysql
# Limitación: vector search nativo requiere MySQL 9+. Pubsub cross-instance
# requiere REDIS_URL (LISTEN/NOTIFY no existe en MySQL).
MYSQL_USER=csm
MYSQL_DATABASE=csm
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ----------------------------------------------------------
# REDIS (opcional — recomendado para multi-instance con MySQL)
# ----------------------------------------------------------
# Si configuras REDIS_URL, CSM usa Redis para pubsub (presence, collab,
# notifications cross-instance). Si NO lo configuras:
#   - DB=Postgres → usa LISTEN/NOTIFY (cero deps).
#   - DB=MySQL    → cae a in-memory (sin fanout cross-instance — single replica only).
# Usar con: docker compose -f docker-compose.yml -f docker-compose.redis.yml up -d
# REDIS_PASSWORD obligatorio para que CSM cifre el handshake en `csm_net`.
REDIS_PASSWORD=

# ----------------------------------------------------------
# AUTH (REQUERIDO)
# ----------------------------------------------------------
# Secret para firmar cookies de sesión + encriptar AI keys at-rest.
# Cambiar este valor invalida TODAS las sesiones y AI keys guardadas.
# Generar:
#   openssl rand -hex 32
AUTH_SECRET=

# ----------------------------------------------------------
# AI PROVIDERS (todos opcionales)
# ----------------------------------------------------------
# Las keys también se pueden guardar desde admin/ajustes/ia (encriptadas
# en BD). Las env vars actúan como FALLBACK si el workspace no tiene key.

# Anthropic Claude — para Agente Editorial avanzado
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI GPT
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq — provider barato y rápido (default si no hay otros)
# https://console.groq.com/
GROQ_API_KEY=

# Mistral
# https://console.mistral.ai/
MISTRAL_API_KEY=

# Ollama (modelos locales) — URL del Ollama server. Si CSM corre en
# Docker, "localhost" no funciona — usa la IP de tu host:
#   OLLAMA_URL=http://host.docker.internal:11434  (Mac/Windows)
#   OLLAMA_URL=http://172.17.0.1:11434            (Linux con Docker default)
OLLAMA_URL=

# ----------------------------------------------------------
# EMAIL (opcional — sin esto, magic-link sale por consola del container)
# ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=CSM <noreply@example.com>

# ----------------------------------------------------------
# STRIPE (opcional — solo si usas memberships)
# ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------
# STORAGE (opcional — para upload de media)
# ----------------------------------------------------------
# Vercel Blob token. Si no lo configuras, los uploads quedan deshabilitados.
BLOB_READ_WRITE_TOKEN=

# ----------------------------------------------------------
# CRON (opcional — para tareas programadas)
# ----------------------------------------------------------
# Si tu reverse proxy o un cron externo llama /api/cron/*, tienen que
# pasar Authorization: Bearer ${CRON_SECRET}.
CRON_SECRET=
